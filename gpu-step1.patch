+#if defined(SC64_SWITCH_GL)
+// Step 1 of the GPU renderer: prove Mesa links and its EGL display initializes
+// on this console (no surface, no change to presentation yet).
+void probe_egl() {
+    EGLDisplay display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+    if (display == EGL_NO_DISPLAY) {
+        sc64::shell::log::warning("EGL probe: no default display");
+        return;
+    }
+    EGLint major = 0, minor = 0;
+    if (!eglInitialize(display, &major, &minor)) {
+        sc64::shell::log::warning("EGL probe: eglInitialize failed (0x%x)", unsigned(eglGetError()));
+        return;
+    }
+    const char* vendor = eglQueryString(display, EGL_VENDOR);
+    const char* apis = eglQueryString(display, EGL_CLIENT_APIS);
+    sc64::shell::log::info("EGL probe: EGL %d.%d, vendor %s, client APIs %s", int(major), int(minor),
+                           vendor ? vendor : "?", apis ? apis : "?");
+    eglTerminate(display);
+}
+#endif
